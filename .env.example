# Firebase認証情報
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Gemini API設定（オプション）
USE_GEMINI=0
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MAX_SAMPLE_ROWS=5
GEMINI_TIMEOUT_MS=12000

# EDINET API（関係会社取得用）
# https://api.edinet-fsa.go.jp/api/auth/index.aspx?mode=1 で発行
EDINET_API_KEY=3a1cd8b3d52748bd922e43ad78fa73be

# CSV処理設定
ENCODING=utf8
DRY_RUN=0
LIMIT=
SAVE_MAPPING=0

# --- PostgreSQL（Cloud SQL Proxy 経由の標準例）---
# repair_companies_column_shift_from_fixed_csv3.get_connection は
# Path(__file__).resolve().parent.parent / ".env" を必ず読み込みます。
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Legatus2000/
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5434
POSTGRES_DB=postgres
DATABASE_URL=postgresql://postgres:Legatus2000/@127.0.0.1:5434/postgres

# --- Enrichment バッチ耐障害性（任意）---
# SEARCH_TIMEOUT=30
# SEARCH_MAX_RETRIES=3
# SEARCH_API_INTERVAL=1.5
# PG_CONNECT_TIMEOUT=15
# PG_MAX_RETRIES=3
